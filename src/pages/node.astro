<script>
  const disclaimer = document.getElementById('nt-disclaimer');
  const disclaimerBtn = document.getElementById('nt-disclaimer-btn');

  if (localStorage.getItem('nt-disclaimer-accepted') === 'true') {
    disclaimer?.remove();
  }

  disclaimerBtn?.addEventListener('click', () => {
    localStorage.setItem('nt-disclaimer-accepted', 'true');
    disclaimer?.remove();
  });

  const pills = document.querySelectorAll('.nt-pill');
  const sections = document.querySelectorAll('.nt-section');
  const progressFill = document.getElementById('nt-progress-fill');
  const total = sections.length;

  function showSection(index: number) {
    sections.forEach(s => s.classList.remove('active'));
    pills.forEach(p => p.classList.remove('active'));

    sections[index]?.classList.add('active');
    pills[index]?.classList.add('active');
    pills[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });

    const pct = ((index + 1) / total) * 100;
    if (progressFill) {
      (progressFill as HTMLElement).style.width = pct + '%';
    }

    window.scrollTo({ top: 80, behavior: 'smooth' });
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      showSection(parseInt((pill as HTMLElement).dataset.section || '0'));
    });
  });

  document.querySelectorAll('[data-next]').forEach(btn => {
    btn.addEventListener('click', () => {
      showSection(parseInt((btn as HTMLElement).dataset.next || '0'));
    });
  });

  document.querySelectorAll('[data-prev]').forEach(btn => {
    btn.addEventListener('click', () => {
      showSection(parseInt((btn as HTMLElement).dataset.prev || '0'));
    });
  });

  showSection(0);
</script>

