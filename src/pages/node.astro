d:var(--nt-accent-dim);border-left:3px solid var(--nt-accent);color:#ffb74d}.nt-code{background:#111;border:1px solid var(--nt-border);border-radius:8px;padding:1rem 1.25rem;overflow-x:auto;margin:1rem 0;font-family:SF Mono,Fira Code,monospace;font-size:.85rem;line-height:1.6;color:#69f0ae}.nt-code .comment{color:#666}.nt-inline-code{background:#222;padding:2px 6px;border-radius:4px;font-family:SF Mono,Fira Code,monospace;font-size:.85em;color:var(--nt-accent)}.nt-table-wrap{overflow-x:auto;margin:1.25rem 0;border-radius:8px;border:1px solid var(--nt-border)}.nt-table{width:100%;border-collapse:collapse;font-size:.9rem}.nt-table th{background:var(--nt-surface);padding:.75rem 1rem;text-align:left;font-weight:600;color:var(--nt-accent);border-bottom:1px solid var(--nt-border);white-space:nowrap}.nt-table td{padding:.65rem 1rem;border-bottom:1px solid var(--nt-border);color:var(--nt-text-muted)}.nt-table tr:last-child td{border-bottom:none}.nt-table tr:hover td{background:var(--nt-surface-hover)}.nt-step{display:flex;gap:1rem;margin:1.25rem 0;padding:1rem 1.25rem;background:var(--nt-surface);border-radius:8px;border:1px solid var(--nt-border)}.nt-step-num{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:var(--nt-accent);color:#000;font-weight:700;font-size:.85rem;flex-shrink:0}.nt-step-content h4{font-size:1rem;font-weight:600;margin-bottom:.25rem;color:var(--nt-text)}.nt-step-content p{font-size:.9rem;color:var(--nt-text-muted);margin:0}.nt-nav-buttons{display:flex;justify-content:space-between;margin-top:3rem;padding-top:1.5rem;border-top:1px solid var(--nt-border)}.nt-nav-btn{padding:.6rem 1.25rem;border-radius:8px;font-size:.9rem;font-weight:500;cursor:pointer;transition:all .2s;border:1px solid var(--nt-border);background:transparent;color:var(--nt-text-muted)}.nt-nav-btn:hover{border-color:var(--nt-accent);color:var(--nt-accent)}.nt-nav-btn.primary{background:var(--nt-accent);color:#000;border-color:var(--